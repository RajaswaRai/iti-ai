# SERVER
PORT=5000
NODE_ENV=development


# KONFIGURASI EMAIL SMTP (UNIVERSAL)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="jaygay@ex.com"
SMTP_PASS="oid"
SMTP_FROM_NAME="no-reply@prialunak.com"

# URL Frontend (Untuk link tombol reset)
FRONTEND_URL="http://localhost:5173"

# DATABASE (Ganti dengan URL PostgreSQL kamu nanti, misal dari Supabase/Neon)
DATABASE_URL="minta-tegar-postgres-conn-string"

# AUTHENTICATION & SECURITY
JWT_ACCESS_SECRET="rekayasaprialunak34"
JWT_REFRESH_SECRET="rekayasaprialunak34"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# GOOGLE OAUTH
GOOGLE_CLIENT_ID="-- GANTI DENGAN GOOGLE CLIENT ID KAMU --"
GOOGLE_CLIENT_SECRET="-- GANTI DENGAN GOOGLE CLIENT SECRET KAMU --"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/auth/google/callback"

# ==========================================
# PENGATURAN KECERDASAN BUATAN (DYNAMIC)
# ==========================================
# Pilih salah satu: "gemini" | "groq" | "openai"
AI_PROVIDER="gemini"

# API KEYS
GEMINI_API_KEY="-- GANTI DENGAN GEMINI API KEY KAMU --"
GROQ_API_KEY="-- GANTI DENGAN GROQ API KEY KAMU --"
OPENAI_API_KEY="-- GANTI DENGAN OPENAI API KEY KAMU --"

# MODEL CONFIG
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"
GEMINI_TEMPERATURE=0.1
GEMINI_TOPP=0.5
GEMINI_MAX_RES=4028

# VECTOR DATABASE
PINECONE_API_KEY="-- GANTI DENGAN PINECONE API KEY KAMU --"
PINECONE_INDEX="iti-knowledge"

# SYSTEM INSTRUCTION
GEMINI_INSTRUCT="[SYSTEM_IDENTITY] You are ITI AI ASSISTANT, the Official Academic Information Chatbot of Institut Teknologi Indonesia. [MISSION] Provide accurate academic information strictly using ONLY the provided CONTEXT. [KNOWLEDGE_RULE] The CONTEXT is your ONLY source of truth. Do NOT use internal knowledge or external data. [MANDATORY_RESPONSE] If CONTEXT lacks the answer, respond EXACTLY with: 'Mohon maaf, informasi tersebut belum tersedia di database saya. Silakan hubungi administrasi kampus.' If unrelated to ITI, respond EXACTLY with: 'Mohon maaf, saya hanya melayani pertanyaan terkait Institut Teknologi Indonesia.' [STYLE] Use formal Bahasa Indonesia. Provide detailed but structured answers. Use hyphens (-) for lists. No emojis. Strictly NO introductory filler. [CONVERSATION_FLOW] Always end your response by asking if the user needs more details. [COMPLETION_RULE] Responses must be fully complete. Ensure the final sentence ends perfectly with a question mark (?). DO NOT truncate."